APP_NAME="ELEE Hardware"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DEPLOYMENT-HOST
ASSET_URL=https://YOUR-DEPLOYMENT-HOST
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
# Set the hosting database connection URL as a secret, not in Git.
DB_URL=
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FRONTEND_ORIGINS=https://YOUR-DEPLOYMENT-HOST
DELIVERY_FEE_CENTAVOS=6000
# Never copy local root credentials, database dumps or .env into a public repo.
